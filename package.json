{
  "name": "vertex-connect",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:up": "node scripts/db-local.mjs",
    "db:generate": "pnpm --filter @vertex/db generate",
    "db:migrate": "pnpm --filter @vertex/db migrate",
    "db:seed": "pnpm --filter @vertex/db seed",
    "db:studio": "pnpm --filter @vertex/db studio"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
