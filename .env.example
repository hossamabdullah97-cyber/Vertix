# Vertex Connect — متغيرات البيئة (انسخه إلى .env واملأ القيم)

NODE_ENV=development
PORT=4000

# قاعدة البيانات (PostgreSQL) — القيم الافتراضية تطابق docker-compose
DATABASE_URL="postgresql://vertex:vertex@localhost:5432/vertex_connect?schema=public"

# Redis (تخزين مؤقت + rate limiting + طوابير)
REDIS_URL="redis://localhost:6379"

# المصادقة (JWT) — استخدم أسراراً قوية في الإنتاج (>= 16 حرفاً)
JWT_SECRET="dev-access-secret-change-me-please"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Proxies in front of the API (a load balancer, a CDN): how many, e.g. 1, or
# their addresses. Leave empty when the API is reached directly. Sign-in limits
# count attempts per caller address, so behind a proxy this must be set, or
# every visitor counts as the proxy. Never "true": clients could then choose
# their own address.
TRUST_PROXY=""

# CORS — أصول مسموح بها مفصولة بفواصل
CORS_ORIGINS="http://localhost:3000"

# Public web origin (used to build NFC redirect URLs to card pages)
APP_PUBLIC_URL="http://localhost:3000"

# تخزين الصور (Cloudflare R2 أو S3 أو أي خدمة متوافقة مع S3)
# مطلوبة في الإنتاج: بدونها تُحفظ الصور على قرص الحاوية وتضيع عند إعادة النشر.
# S3_ENDPOINT فارغ لـ AWS S3، ولـ R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_URL هو العنوان العام للـ bucket (دومين مخصص أو رابط r2.dev)
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="vertex-connect"
S3_PUBLIC_URL=""

# الفوترة عبر Paymob — اتركها فارغة لتعطيل الفوترة محلياً
# المفاتيح من لوحة Paymob: Settings → API Keys. الـ Integration IDs من Developers → Payment Integrations:
# واحد Online Card (3DS) للدفعة الأولى، وواحد MOTO للتجديد الشهري.
# بعد ضبط الأسعار شغّل: pnpm --filter @vertex/api paymob:plans، وضع أرقام الخطط الناتجة في PAYMOB_PLAN_*.
PAYMOB_BASE_URL="https://accept.paymob.com"
PAYMOB_API_KEY=""
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_CARD_INTEGRATION_ID=""
PAYMOB_MOTO_INTEGRATION_ID=""
PAYMOB_PLAN_PRO=""
PAYMOB_PLAN_BUSINESS=""
# الأسعار الشهرية بالجنيه المصري؛ الخطة بدون سعر لا تُعرض للبيع
PRICE_PRO_EGP=""
PRICE_BUSINESS_EGP=""
# العنوان العام للـ API، تستقبل عليه Paymob إشعارات الدفع
API_PUBLIC_URL="http://localhost:4000"

# Sentry (المراقبة) — اتركها فارغة لتعطيلها
SENTRY_DSN=""

# البريد (Resend) — اتركه فارغاً ليُسجَّل الرابط في الـ console بدل الإرسال
RESEND_API_KEY=""
EMAIL_FROM="Vertex Connect <onboarding@resend.dev>"

# تنبيهات واتساب للعملاء الجدد (WhatsApp Business Cloud API من Meta) — اتركها فارغة لإيقافها
# الرسالة لازم تكون قالب معتمد من Meta بنفس الاسم، بلغتين (en و ar)، فئة Utility:
#   en: "New on your Vertex card — {{1}}: {{2}}. {{3}}"
#   ar: "جديد على بطاقتك في Vertex — {{1}}: {{2}}. {{3}}"
#   وزر رابط (URL) "Open lead" / "افتح العميل" عنوانه: APP_PUBLIC_URL/leads?lead={{1}}
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_LEAD_TEMPLATE="new_lead"
WHATSAPP_API_VERSION="v21.0"

# Apple Wallet — اتركها فارغة لإخفاء زر "Add to Apple Wallet" من البطاقة
# من Pass Type ID في حساب Apple Developer. قيم الـ PEM تُكتب كنص PEM أو base64 له.
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_CERT=""
APPLE_PASS_KEY=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT=""

# Google Wallet — اتركها فارغة لإخفاء زر "Save to Google Wallet"
# رقم الـ Issuer من Google Pay & Wallet Console، وملف JSON لـ service account لديه صلاحية عليه (نص JSON أو base64).
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT=""
