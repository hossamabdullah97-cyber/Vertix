# Vertex Connect — متغيرات البيئة (انسخه إلى .env واملأ القيم)

NODE_ENV=development
PORT=4000

# قاعدة البيانات (PostgreSQL) — القيم الافتراضية تطابق docker-compose
DATABASE_URL="postgresql://vertex:vertex@localhost:5432/vertex_connect?schema=public"

# Redis (تخزين مؤقت + rate limiting + طوابير)
REDIS_URL="redis://localhost:6379"

# المصادقة (JWT) — استخدم أسراراً قوية في الإنتاج (>= 16 حرفاً)
JWT_SECRET="dev-access-secret-change-me-please"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Optional: encrypts two-step verification secrets (32 bytes, base64:
# `openssl rand -base64 32`). Without it a key is derived from JWT_SECRET;
# changing whichever is used turns existing authenticator setups off.
TOTP_ENCRYPTION_KEY=""

# Encrypts stored integration credentials, webhook signing secrets and single
# sign-on client secrets (32 bytes, base64: `openssl rand -base64 32`).
# Without it, connecting apps, webhooks and single sign-on are turned off.
# Keep it: changing it makes the stored credentials unreadable.
INTEGRATION_ENCRYPTION_KEY=""

# Proxies in front of the API (a load balancer, a CDN): how many, e.g. 1, or
# their addresses. Leave empty when the API is reached directly. Sign-in limits
# count attempts per caller address, so behind a proxy this must be set, or
# every visitor counts as the proxy. Never "true": clients could then choose
# their own address.
TRUST_PROXY=""

# CORS — أصول مسموح بها مفصولة بفواصل
CORS_ORIGINS="http://localhost:3000"

# Public web origin (used to build NFC redirect URLs to card pages)
APP_PUBLIC_URL="http://localhost:3000"

# The address written on NFC chips: <NEXT_PUBLIC_TAP_URL>/t/<serial>. A short
# domain of your own (https://vtx.link) pointing at the web app. Choose it
# once and keep it: every chip shipped carries it, and with it set the chip
# programmer locks chips by default. Empty: the web app's own address.
# Build-time for the web (Docker build arg), EXPO_PUBLIC_TAP_URL for the app.
NEXT_PUBLIC_TAP_URL=""

# تخزين الصور (Cloudflare R2 أو S3 أو أي خدمة متوافقة مع S3)
# مطلوبة في الإنتاج: بدونها تُحفظ الصور على قرص الحاوية وتضيع عند إعادة النشر.
# S3_ENDPOINT فارغ لـ AWS S3، ولـ R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_URL هو العنوان العام للـ bucket (دومين مخصص أو رابط r2.dev)
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="vertex-connect"
S3_PUBLIC_URL=""

# الفوترة عبر Paymob — اتركها فارغة لتعطيل الفوترة محلياً
# المفاتيح من لوحة Paymob: Settings → API Keys. الـ Integration IDs من Developers → Payment Integrations:
# واحد Online Card (3DS) للدفعة الأولى، وواحد MOTO للتجديد الشهري.
# بعد ضبط الأسعار شغّل: pnpm --filter @vertex/api paymob:plans، وضع أرقام الخطط الناتجة في PAYMOB_PLAN_*.
PAYMOB_BASE_URL="https://accept.paymob.com"
PAYMOB_API_KEY=""
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_CARD_INTEGRATION_ID=""
PAYMOB_MOTO_INTEGRATION_ID=""
PAYMOB_PLAN_PERSONAL=""
PAYMOB_PLAN_PRO=""
PAYMOB_PLAN_BUSINESS=""
# الأسعار الشهرية بالجنيه المصري؛ الخطة بدون سعر لا تُعرض للبيع
# خطة الفرد: لمساحة شخصية واحدة (3 بطاقات، 10 شرائح)
PRICE_PERSONAL_EGP=""
PRICE_PRO_EGP=""
PRICE_BUSINESS_EGP=""
# بيانات البائع كما تظهر على كل فاتورة (الاسم القانوني، العنوان، رقم التسجيل الضريبي، بريد الفواتير)
BILLING_SELLER_NAME="Vertex Connect"
BILLING_SELLER_ADDRESS=""
BILLING_SELLER_TAX_ID=""
BILLING_SELLER_EMAIL=""
# نسبة ضريبة القيمة المضافة داخل الأسعار (مثل 14)؛ فارغة = لا تظهر ضريبة على الفاتورة
BILLING_VAT_PERCENT=""
# العنوان العام للـ API، تستقبل عليه Paymob إشعارات الدفع
API_PUBLIC_URL="http://localhost:4000"

# Sentry (المراقبة) — اتركها فارغة لتعطيلها
SENTRY_DSN=""
# من يُبلَّغ بالبريد عند ظهور خطأ جديد (في المتصفح أو الـ API) أو عودة خطأ تم إصلاحه؛ فارغ = بلا تنبيهات. الأخطاء تظهر في لوحة الإدارة في كل الأحوال.
OPS_ALERT_EMAIL=""
# صندوق الدعم: رسائل "تواصل معنا" من صفحة المساعدة تصل إليه (والرد عليها يصل للعميل مباشرةً). فارغ = OPS_ALERT_EMAIL. الرسائل تظهر في لوحة الإدارة في كل الأحوال.
SUPPORT_INBOX_EMAIL=""

# البريد (Resend) — اتركه فارغاً ليُسجَّل الرابط في الـ console بدل الإرسال
RESEND_API_KEY=""
EMAIL_FROM="Vertex Connect <onboarding@resend.dev>"

# الدخول بحساب جوجل — اتركه فارغاً لإخفاء الزر
# Client ID من نوع "Web application" في Google Cloud Console (APIs & Services › Credentials)،
# وضيف عنوان الموقع (APP_PUBLIC_URL) في "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=""

# ربط تقويم جوجل (كل عضو بيربط تقويمه من إعدادات مواعيد الكارت) — اتركه فارغاً لإخفاء الربط.
# من Google Cloud Console: فعّل "Google Calendar API"، واعمل OAuth Client من نوع "Web application"،
# وضيف في "Authorized redirect URIs": <API_PUBLIC_URL>/api/integrations/oauth/callback
# يحتاج كمان INTEGRATION_ENCRYPTION_KEY لحفظ التوكنات مشفرة.
OAUTH_GOOGLE_CALENDAR_CLIENT_ID=""
OAUTH_GOOGLE_CALENDAR_CLIENT_SECRET=""

# قراءة الكروت الورق: بتشتغل من غير أي مفتاح (رمز QR + قراءة النص على موبايل المستخدم نفسه).
# اختياري: مفتاح Claude من Anthropic لدقة أعلى في الأسماء والعربي — لو فاضي بتفضل القراءة على الموبايل.
# المفتاح من console.anthropic.com. الموديل الافتراضي Claude Haiku (أرخص وكافي للقراءة).
ANTHROPIC_API_KEY=""
LEAD_SCAN_MODEL="claude-haiku-4-5-20251001"

# تنبيهات واتساب للعملاء الجدد (WhatsApp Business Cloud API من Meta) — اتركها فارغة لإيقافها
# الرسالة لازم تكون قالب معتمد من Meta بنفس الاسم، بلغتين (en و ar)، فئة Utility:
#   en: "New on your Vertex card — {{1}}: {{2}}. {{3}}"
#   ar: "جديد على بطاقتك في Vertex — {{1}}: {{2}}. {{3}}"
#   وزر رابط (URL) "Open lead" / "افتح العميل" عنوانه: APP_PUBLIC_URL/leads?lead={{1}}
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_LEAD_TEMPLATE="new_lead"
WHATSAPP_API_VERSION="v21.0"

# Apple Wallet — اتركها فارغة لإخفاء زر "Add to Apple Wallet" من البطاقة
# من Pass Type ID في حساب Apple Developer. قيم الـ PEM تُكتب كنص PEM أو base64 له.
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_CERT=""
APPLE_PASS_KEY=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT=""

# Google Wallet — اتركها فارغة لإخفاء زر "Save to Google Wallet"
# رقم الـ Issuer من Google Pay & Wallet Console، وملف JSON لـ service account لديه صلاحية عليه (نص JSON أو base64).
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT=""

# إشعارات الموبايل (Web Push) — بدونها زر "الإشعارات على هذا الجهاز" مخفي.
# ولّدها مرة واحدة: npx web-push generate-vapid-keys — واحتفظ بها: تغييرها يوقف إشعارات كل الأجهزة.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# بريد أو رابط للتواصل يُرسل لخدمات الإشعارات (mailto:… أو https://…)؛ افتراضياً APP_PUBLIC_URL
VAPID_SUBJECT=""

# ---------------------------------------------------------------------------
# Production (docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# الدومينات: وجّهها لعنوان السيرفر وافتح المنافذ 80 و443، وCaddy يستخرج شهادات HTTPS وحده.
# app.example.com — البرنامج وصفحات الكروت
APP_DOMAIN=""
# api.example.com
API_DOMAIN=""
# اختياري: الدومين القصير للشرائح (نفسه في NEXT_PUBLIC_TAP_URL مع https://)
TAP_DOMAIN=""
# بريد تصلك عليه تنبيهات الشهادات من Let's Encrypt
ACME_EMAIL=""
# في الإنتاج: احذف CORS_ORIGINS وAPP_PUBLIC_URL من هذا الملف أو اضبطهما على
# https://APP_DOMAIN؛ لو تُركا فارغين يُشتقّان من الدومينات تلقائياً.

# كلمة سر قاعدة البيانات — طويلة وعشوائية (مطلوبة)
POSTGRES_PASSWORD=""

# بيانات الشركة على صفحات الخصوصية والشروط والاسترداد والتواصل (/legal/…)
# Paymob تطلب هذه الصفحات ببيانات حقيقية قبل تفعيل الحساب.
# الاسم القانوني للشركة
NEXT_PUBLIC_COMPANY_NAME=""
NEXT_PUBLIC_COMPANY_ADDRESS=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""

# النسخ الاحتياطي لقاعدة البيانات (خدمة backup): نسخة عند التشغيل ثم كل 24 ساعة.
BACKUP_INTERVAL_HOURS="24"
BACKUP_KEEP_DAYS="14"
# bucket خارج السيرفر (يستخدم مفاتيح S3_* أعلاه). بدونه النسخ على نفس السيرفر فقط.
# اعمل للـ bucket قاعدة lifecycle تمسح النسخ الأقدم من 14 يوماً.
BACKUP_S3_BUCKET=""
BACKUP_S3_PREFIX="db"
# رابط يُستدعى بعد كل نسخة ناجحة (healthchecks.io مثلاً) لينبهك لو توقفت النسخ
BACKUP_HEARTBEAT_URL=""
