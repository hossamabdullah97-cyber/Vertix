    "html-to-image": "1.11.11",
    "i18next": "^26.3.6",
    "jsqr": "^1.4.0",
    "next": "15.5.27",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.10",
    "read-excel-file": "^5.8.8",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
