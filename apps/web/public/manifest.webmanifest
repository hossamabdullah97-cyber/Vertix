{
  "name": "Vertex Connect",
  "short_name": "Vertex",
  "description": "NFC business cards, and a pipeline for the leads they bring.",
  "id": "/dashboard",
  "start_url": "/dashboard?source=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f3ef",
  "theme_color": "#2563eb",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Leads", "short_name": "Leads", "url": "/leads?source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Cards", "short_name": "Cards", "url": "/cards?source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
