# Where the API is. On a phone, use your computer's address on the Wi-Fi
# (not localhost), e.g. http://192.168.1.20:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
# The web app, for the sections the app opens from the site.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Optional: the short address written on NFC chips (NEXT_PUBLIC_TAP_URL on the web).
EXPO_PUBLIC_TAP_URL=
